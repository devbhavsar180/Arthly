# ==============================================================================
# My Expense Tracker - Backend Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# NEVER commit your actual '.env' file containing real secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Choose ONE of the configurations below:

# OPTION A: Local SQLite (Quick-start / testing without installing PostgreSQL)
DATABASE_URL=sqlite:///./expense_tracker.db

# OPTION B: Local PostgreSQL (Local development with multi-device support)
# DATABASE_URL=postgresql+psycopg://expense_user:your_local_password@localhost:5432/expense_tracker

# OPTION C: Neon PostgreSQL (Production Cloud Database for Render deployment)
# Get your connection string from the Neon Console (https://console.neon.tech).
# The app automatically supports both 'postgresql://' and 'postgresql+psycopg://'.
# DATABASE_URL=postgresql+psycopg://neondb_owner:your_neon_password@ep-cool-pooler-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random secret using Python:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret_key_at_least_32_characters

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 3. APPLICATION & CORS SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=My Expense Tracker API
APP_ENV=development

# Comma-separated list of allowed origins.
# For local development: http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081
# For production (Render/Vercel): add your deployed frontend domain
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# ------------------------------------------------------------------------------
# 4. OPTIONAL SMTP CONFIGURATION (Forgot Password Emails)
# ------------------------------------------------------------------------------
# Leave blank to run in offline/personal mode (reset tokens printed to server logs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
