# ==============================================================================
# Environment & Secret Files (NEVER COMMIT CREDENTIALS)
# ==============================================================================
.env
.env.*
*.env
!.env.example
!*.env.example
*.pem
*.key
*.cert
*.crt
secrets.json

# Subfolder environments explicitly
backend/.env
backend/.env.*
!backend/.env.example
web/.env
web/.env.*
web/.env.local
!web/.env.example
mobile/.env
mobile/.env.*
!mobile/.env.example

