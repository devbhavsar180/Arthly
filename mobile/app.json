{
  "expo": {
    "name": "Arthly",
    "slug": "my-expense-tracker",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "arthly",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personal.myexpensetracker",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.arthly.personalfinance",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "./plugins/withCleartextTraffic",
      "./plugins/withShareIntent"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:8000/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "de390afc-5b8c-4190-9f01-9b453220dbdf"
      }
    },
    "owner": "devbhavsar180",
    "updates": {
      "url": "https://u.expo.dev/de390afc-5b8c-4190-9f01-9b453220dbdf"
    }
  }
}
