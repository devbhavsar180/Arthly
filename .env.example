# ==============================================================================
# My Expense Tracker - Full-Stack Environment Variables Reference
# ==============================================================================
# This file provides a centralized reference for all environment variables used
# across the project. Copy variables to the appropriate subfolder's environment file:
#
#   Backend : backend/.env       (see backend/.env.example)
#   Frontend: web/.env.local     (see web/.env.example)
#   Mobile  : mobile/.env        (or configured in-app via Server Settings)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (backend/.env)
# ------------------------------------------------------------------------------
# Database Options:
# SQLite (Local):
DATABASE_URL=sqlite:///./expense_tracker.db
# PostgreSQL (Local):
# DATABASE_URL=postgresql+psycopg://expense_user:your_password@localhost:5432/expense_tracker
# Neon PostgreSQL (Cloud / Render):
# DATABASE_URL=postgresql+psycopg://neondb_owner:your_password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security:
JWT_SECRET_KEY=replace_with_a_long_random_secret_key_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30

# Application:
APP_NAME=My Expense Tracker API
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# Optional SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------------------------
# WEB FRONTEND (web/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production (Render):
# NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api/v1

# ------------------------------------------------------------------------------
# MOBILE APP (mobile/.env)
# ------------------------------------------------------------------------------
# Android Emulator:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
# Physical Phone (LAN Wi-Fi):
# EXPO_PUBLIC_API_URL=http://<YOUR_PC_LAN_IP>:8000/api/v1
# Production (Render):
# EXPO_PUBLIC_API_URL=https://your-backend-api.onrender.com/api/v1
